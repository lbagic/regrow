[native] aerial-wallpapers: sudo /bin/sh -c [ -d "$1" ] || { echo "$1 is not a folder" >&2; exit 1; }; for t in "$2"/*/T/com.apple.idleassetsd; do if [ -d "$t" ] && [ ! -L "$t" ] && [ ! -L "${t%/*}" ]; then /usr/bin/find "$t" -ignore_readdir_race -mindepth 1 -maxdepth 1 -type f -name "CFNetworkDownload_*.tmp" -delete || [ ! -d "$t" ] || exit; fi; done; /usr/bin/find "$1" -ignore_readdir_race -type f -name "*.mov" -delete sh /Library/Application Support/com.apple.idleassetsd/Customer /private/var/folders/zz  (pre: hold-recheck)
